PORT=3000
AWS_REGION=ap-south-1
# Choose mysql (RDS MySQL or Aurora MySQL compatible). Credentials should be provided via SSM/Secrets Manager on AWS.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=student_lab
DB_USER=student_app
DB_PASSWORD=change-me
# Optional absolute path to official AWS RDS CA bundle for explicit certificate verification
# DB_SSL_CA=/etc/ssl/certs/global-bundle.pem
# Optional: read replica endpoint for GET /api/students list/detail reads. Writes always use DB_HOST.
DB_READ_HOST=
DYNAMODB_TABLE=StudentLabActivity
